<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#18364A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <FrameLayout
            android:id="@+id/splashLogoContainer"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:contentDescription="ReshQMesh connected shield logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.015"
            android:text="ReshQMesh"
            android:textColor="#FFFFFF"
            android:textSize="35sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="OFFLINE EMERGENCY COMMUNICATION"
            android:textColor="#48B9A5"
            android:textSize="12sp"
            android:letterSpacing="0.09" />

        <View
            android:layout_width="52dp"
            android:layout_height="3dp"
            android:layout_marginTop="22dp"
            android:background="#48B9A5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Stay connected. Get help."
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Designed to support emergency communication\nwhen normal networks are unavailable."
            android:textColor="#C8D8E0"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:text="RESCUE  •  RESILIENCE  •  CONNECTIVITY"
        android:textColor="#AFC7D2"
        android:textSize="10sp" />

</FrameLayout>
